{
  "expo": {
    "name": "Keel",
    "slug": "keel",
    "version": "1.0.0",
    "scheme": "keel",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#04112E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ch.keelapp.keel",
      "appleTeamId": "TBF3VV2BT8",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.ch.keelapp.keel"],
        "com.apple.developer.icloud-container-identifiers": ["iCloud.ch.keelapp.keel"],
        "com.apple.developer.icloud-services": ["CloudDocuments"],
        "com.apple.developer.ubiquity-container-identifiers": ["iCloud.ch.keelapp.keel"],
        "com.apple.developer.ubiquity-kvstore-identifier": "$(TeamIdentifierPrefix)$(CFBundleIdentifier)"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.USE_BIOMETRIC", "android.permission.USE_FINGERPRINT"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Keel uses Face ID to unlock the app."
        }
      ],
      "@bacons/apple-targets",
      "react-native-cloud-storage",
      "expo-secure-store",
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a3492697-8f9d-4a04-a289-9044b2391747"
      }
    },
    "owner": "kazs-team"
  }
}
