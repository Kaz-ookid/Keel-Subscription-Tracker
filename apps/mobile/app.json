{
  "expo": {
    "name": "Keel",
    "slug": "keel",
    "version": "1.1.1",
    "scheme": "keel",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ch.keelapp.keel",
      "appleTeamId": "TBF3VV2BT8",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": ["en", "fr", "de", "it", "pl"]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1", "1C8F.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          }
        ]
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.ch.keelapp.keel"],
        "com.apple.developer.ubiquity-kvstore-identifier": "$(TeamIdentifierPrefix)$(CFBundleIdentifier)",
        "com.apple.developer.private-cloud-compute": true
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#F1F5F6",
          "dark": {
            "backgroundColor": "#0B1A33"
          }
        }
      ],
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Keel uses Face ID to unlock the app."
        }
      ],
      "@bacons/apple-targets",
      "react-native-cloud-storage",
      "expo-secure-store",
      "expo-iap",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Keel reads the text of the screenshots you pick, on this iPhone.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a3492697-8f9d-4a04-a289-9044b2391747"
      }
    },
    "owner": "kazs-team"
  }
}
