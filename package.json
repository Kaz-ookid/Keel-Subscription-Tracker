{
  "name": "keel",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.4",
    "typescript-eslint": "^8.61.0"
  },
  "scripts": {
    "test": "npm test -w @keel/core",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p apps/mobile",
    "lint": "eslint .",
    "format": "prettier --write ."
  }
}
